{
  "expo": {
    "name": "Leapit",
    "slug": "Leapit",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/LeapitLogo1024.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/LeapitLogo1024.png",
        "backgroundColor": "#161622"
      },
      "edgeToEdgeEnabled": false,
      "package": "com.leapiet.jobs"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/LeapitLogo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#101216",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "Leapit fotoğraf çekip mesaj olarak göndermek için kameranıza erişmek istiyor."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Leapit galeriden fotoğraf seçip mesaj olarak göndermek için medya kütüphanenize erişmek istiyor."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0a24d955-1dc6-4108-baf5-dd48ad24f115"
      }
    }
  }
}
